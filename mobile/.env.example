# 本地开发才需要设置；Release / OTA 打包请勿取消注释，否则会连不上服务器。
# EXPO_PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1
# 真机 Expo Go 调试请改为电脑局域网 IP，例如：
# EXPO_PUBLIC_API_BASE=http://192.168.1.10:8000/api/v1
# 未设置时 Release 包默认使用 http://81.71.159.218:8000/api/v1

# 高德「Web端(JS API)」Key —— 用于手机地图显示（与后端 Web服务 Key 不同）
# EXPO_PUBLIC_AMAP_JS_KEY=your-amap-js-key
